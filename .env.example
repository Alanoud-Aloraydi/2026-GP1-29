# Copy this file to .env and fill in the values. The .env file is excluded from version control.

# Sole judge: hosted TypeSafe Jev. Never commit a real key.
TYPESAFE_API_KEY=
HARASS_JEV_MODEL=jev-1.13.0
# Experimental review threshold; calibrate on held-out human-labelled Arabic responses.
HARASS_JEV_MIN_CONFIDENCE=0.8

# Generation parameters applied to every model under evaluation.
HARASS_TARGET_TEMPERATURE=0.0
HARASS_TARGET_MAX_COMPLETION_TOKENS=900

# Cases sent and judged at the same time; 1 preserves serial adaptive feedback.
HARASS_MAX_CONCURRENCY=1

# Entire logical target-and-judge attempt; failures remain unscored.
HARASS_ATTEMPT_TIMEOUT_SECONDS=300

# Model under evaluation, used by the command line and the live integration test until
# connections are managed through the web interface. The command-line options
# --target-base-url and --target-model override the first two; the key is read only from here.
# Any OpenAI-compatible endpoint; the values below are placeholders.
HARASS_TARGET_BASE_URL=https://api.example.com/v1
HARASS_TARGET_MODEL=model-name
HARASS_TARGET_API_KEY=

# Backend (HTTP API) only.
# PostgreSQL connection URL, e.g. postgresql+psycopg://user:password@localhost:5432/harass
HARASS_DATABASE_URL=postgresql+psycopg://harass:harass@localhost:5432/harass
# Fernet key protecting clients' stored API keys; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HARASS_ENCRYPTION_KEY=

# Generate an independent random secret (at least 32 bytes) for JWT signing.
HARASS_JWT_SECRET=
# Use true behind HTTPS; false only for local HTTP development.
HARASS_COOKIE_SECURE=false
HARASS_SESSION_SECONDS=3600

# Comma-separated hostnames for private target endpoints; public targets require HTTPS.
HARASS_PRIVATE_TARGET_HOSTS=
HARASS_ALLOW_TARGET_HTTP=false
# Comma-separated HTTP Host values accepted by the API.
HARASS_ALLOWED_HOSTS=localhost,127.0.0.1
# Up to two previous signing keys during a bounded key rotation.
HARASS_JWT_PREVIOUS_SECRETS=
# Optional maintained SHA-256 password blocklist, one digest per line.
HARASS_PASSWORD_BLOCKLIST_PATH=
